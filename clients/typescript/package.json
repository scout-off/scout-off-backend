{
  "name": "@scoutoff/api-client",
  "version": "1.0.0",
  "description": "Versioned TypeScript client for the ScoutOff API",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scout-off/scout-off-backend.git",
    "directory": "clients/typescript"
  },
  "bugs": {
    "url": "https://github.com/scout-off/scout-off-backend/issues"
  },
  "homepage": "https://github.com/scout-off/scout-off-backend/tree/main/clients/typescript#readme",
  "keywords": [
    "scoutoff",
    "api-client",
    "typescript",
    "openapi",
    "stellar"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/schema.js",
    "dist/schema.d.ts"
  ],
  "scripts": {
    "prepack": "npm --prefix ../.. run build:client"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0"
  }
}
