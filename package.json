{
  "name": "scout-off-backend",
  "version": "1.0.0",
  "description": "Backend API for ScoutOff \u2014 decentralized football scouting platform on Stellar",
  "main": "dist/index.js",
  "engines": {
    "node": "20.x",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "predev": "node scripts/validate-env.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "prestart": "node scripts/validate-env.js",
    "start": "node dist/index.js",
    "test": "node scripts/run-tests.js",
    "test:coverage": "node --expose-gc node_modules/jest/bin/jest.js --runInBand --coverage",
    "test:postgres": "DB_DRIVER=postgres node --expose-gc node_modules/jest/bin/jest.js --runInBand --testPathIgnorePatterns=\"/node_modules/\" --testPathIgnorePatterns=\"tests/controllers/webhookAdminController.test.ts\" --testPathIgnorePatterns=\"tests/db/backfill.test.ts\" --testPathIgnorePatterns=\"tests/db/sqlInjectionRegression.test.ts\" --testPathIgnorePatterns=\"tests/e2e/milestonePromotion.e2e.test.ts\" --testPathIgnorePatterns=\"tests/e2e/scoutUnlock.e2e.test.ts\" --testPathIgnorePatterns=\"tests/routes/adminAuditTrail.test.ts\" --testPathIgnorePatterns=\"tests/routes/adminExport.test.ts\" --testPathIgnorePatterns=\"tests/routes/adminPagination.test.ts\" --testPathIgnorePatterns=\"tests/routes/adminQuerySchema.test.ts\" --testPathIgnorePatterns=\"tests/routes/exportStreaming.test.ts\" --testPathIgnorePatterns=\"tests/routes/reindex.test.ts\" --testPathIgnorePatterns=\"tests/routes/playerListFreshness.test.ts\" --testPathIgnorePatterns=\"tests/routes/trialOffers.test.ts\" --testPathIgnorePatterns=\"tests/services/indexer.test.ts\" --testPathIgnorePatterns=\"tests/services/indexerDispatch.test.ts\" --testPathIgnorePatterns=\"tests/services/tierPromotion.test.ts\" --testPathIgnorePatterns=\"tests/services/webhooks.test.ts\"",
    "test:watch": "node node_modules/jest/bin/jest.js --watch",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts' 'scripts/*.ts' --ext .ts",
    "seed": "ts-node --project tsconfig.scripts.json scripts/seed.ts",
    "migration:status": "ts-node --project tsconfig.scripts.json scripts/migration-status.ts",
    "build:openapi": "node scripts/generate-openapi-json.js",
    "validate:openapi": "node scripts/validate-openapi.js",
    "docs:check": "node scripts/check-route-docs.js",
    "check:sql-injection": "node scripts/check-sql-injection.js",
    "loadtest": "ts-node --project tsconfig.scripts.json scripts/loadtest.ts",
    "backfill": "node scripts/backfill.js",
    "reencrypt-webhook-secrets": "node scripts/reencrypt-webhook-secrets.js",
    "backup-db": "bash scripts/backup-db.sh",
    "verify-backup": "bash scripts/verify-backup.sh"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix --ext .ts"
    ],
    "tests/**/*.ts": [
      "eslint --fix --ext .ts"
    ]
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@stellar/stellar-sdk": "17.0.0",
    "axios": "1.18.1",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.1",
    "cors": "2.8.5",
    "dataloader": "2.2.3",
    "dotenv": "16.4.5",
    "express": "4.22.2",
    "form-data": "4.0.6",
    "graphql": "16.14.2",
    "graphql-yoga": "5.21.2",
    "helmet": "^8.0.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.2",
    "multiformats": "^14.0.5",
    "node-fetch": "^2.7.0",
    "pg": "8.11.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@paralleldrive/cuid2": "^2.3.1",
    "@types/autocannon": "^7.12.7",
    "@types/better-sqlite3": "7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.12.7",
    "@types/node-fetch": "^2.6.11",
    "@types/pg": "8.11.6",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autocannon": "^8.0.0",
    "dezalgo": "^1.0.4",
    "eslint": "^8.57.1",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "ioredis-mock": "8.13.1",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "lint-staged": "^15.4.3",
    "multiformats": "^14.0.5",
    "supertest": "7.0.0",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "2.0.0",
    "typescript": "5.4.5"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "testMatch": [
          "**/tests/**/*.test.ts",
          "!**/tests/scripts/**"
        ],
        "setupFilesAfterEnv": [
          "<rootDir>/tests/setup.ts"
        ],
        "transform": {
          "^.+\\.tsx?$": [
            "ts-jest",
            {
              "diagnostics": false,
              "tsconfig": "<rootDir>/tsconfig.eslint.json"
            }
          ],
          "^.+\\.js$": "ts-jest"
        },
        "transformIgnorePatterns": [
          "/node_modules/(?!(@stellar/stellar-sdk|uint8array-extras|@exodus/bytes|@noble/ed25519|@noble/hashes)/)"
        ],
        "moduleNameMapper": {
          "^@paralleldrive/cuid2$": "<rootDir>/__mocks__/@paralleldrive/cuid2.js",
          "^multiformats/cid$": "<rootDir>/__mocks__/multiformats/cid.js"
        },
        "globals": {
          "ts-jest": {
            "diagnostics": false,
            "tsconfig": "<rootDir>/tsconfig.eslint.json"
          }
        },
        "collectCoverageFrom": [
          "src/**/*.ts",
          "!src/**/*.d.ts"
        ],
        "coverageThreshold": {
          "global": {
            "branches": 70,
            "functions": 75,
            "lines": 80,
            "statements": 80
          }
        }
      },
      {
        "displayName": "scripts",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "testMatch": [
          "**/tests/scripts/**/*.test.ts"
        ],
        "setupFiles": [
          "<rootDir>/tests/setup-shell.ts"
        ],
        "transformIgnorePatterns": [
          "/node_modules/(?!(@stellar/stellar-sdk|uint8array-extras|@exodus/bytes|@noble/ed25519|@noble/hashes)/)"
        ],
        "globals": {
          "ts-jest": {
            "diagnostics": false
          }
        }
      }
    ]
  },
  "overrides": {
    "brace-expansion": "2.1.4"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}