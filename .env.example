# ============================================================
# ScoutOff Backend — Environment Variables
# Copy this file to .env and fill in real values for your setup.
# Never commit .env — only .env.example should be tracked in git.
# ============================================================

# ----------------------------------------
# Stellar / Soroban
# ----------------------------------------
# CONTRACT_ID — Legacy single-contract address. Still accepted for backward
# compatibility with single-contract deployments. For multi-contract deployments
# (the default since issue #1016) set the per-contract IDs below instead.
# Falls back: each per-contract var → CONTRACT_ID → '' (empty).
CONTRACT_ID=

# Per-contract IDs — set these when each Soroban crate is deployed separately.
# REGISTER_CONTRACT_ID  — deployed `register` contract (player profiles & progress).
# PROGRESS_CONTRACT_ID  — deployed `progress` contract (milestone verification).
# SUBSCRIPTION_CONTRACT_ID — deployed `subscription` contract (scout subscriptions & fees).
# CONNECTION_CONTRACT_ID   — deployed `connection` contract (scout-player connections & trial offers).
#
# If a per-contract variable is unset, its value falls back to CONTRACT_ID above,
# so existing single-contract deployments require no changes.
REGISTER_CONTRACT_ID=
PROGRESS_CONTRACT_ID=
SUBSCRIPTION_CONTRACT_ID=
CONNECTION_CONTRACT_ID=

# HORIZON_URL — Required. Stellar Horizon RPC endpoint.
HORIZON_URL=https://horizon-testnet.stellar.org

# SOROBAN_RPC_URL — Required. Soroban RPC endpoint for contract calls.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# NETWORK — Required. Which Stellar network to target: "testnet" or "mainnet".
NETWORK=testnet

# NETWORK_PASSPHRASE — Required. Network passphrase matching NETWORK above.
# Testnet: Test SDF Network ; September 2015
# Mainnet: Public Global Stellar Network ; September 2015
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ----------------------------------------
# Auth
# ----------------------------------------
# JWT_SECRET — Required. Minimum 32 characters. Rotate immediately on suspected compromise.
# Generate locally: `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars

# JWT_SECRET_PREVIOUS — Optional. Used only during key rotation.
# JWT_SECRET_PREVIOUS_UNTIL — Optional. Absolute end of the previous-secret
#   grace window: Unix timestamp (seconds) OR ISO-8601 datetime.
#   When unset, the previous secret remains accepted until you clear JWT_SECRET_PREVIOUS.
# Rotation procedure (zero-downtime):
#   1. Copy JWT_SECRET value into JWT_SECRET_PREVIOUS
#   2. Set JWT_SECRET_PREVIOUS_UNTIL to now + max token lifetime
#      (refresh TTL is 7 days — e.g. `date -u -v+7d +%Y-%m-%dT%H:%M:%SZ` on macOS)
#   3. Set JWT_SECRET to a new secret (openssl rand -hex 32)
#   4. Deploy — old tokens still verify via JWT_SECRET_PREVIOUS until UNTIL
#   5. After the grace window (or once sessions expire), remove JWT_SECRET_PREVIOUS
#      and JWT_SECRET_PREVIOUS_UNTIL, then redeploy
JWT_SECRET_PREVIOUS=
JWT_SECRET_PREVIOUS_UNTIL=

# JWT_ACCESS_TTL_SECONDS — Optional. Access token lifetime in seconds (default: 900 = 15 min). Integer >= 1 (seconds).
JWT_ACCESS_TTL_SECONDS=900

# SEP10_SERVER_SECRET — Required in staging/production. Stellar secret key (starts with 'S')
# used to sign and verify SEP-10 challenge transactions.
#
# WHY THIS MATTERS: Every backend instance in a horizontally-scaled deployment must share
# the same keypair.  Without it, a challenge issued by instance A can only be verified by
# instance A.  If the wallet's POST /auth/token request lands on a different instance, the
# server-signature check fails — causing intermittent auth errors that are extremely hard
# to diagnose because the client did nothing wrong.
#
# HOW TO GENERATE:
#   stellar keys generate --network testnet   # prints a public/secret key pair
#   # Use the secret key (starts with 'S') as the value below.
#
# ROTATION: See docs/auth.md for the safe key-rotation procedure.
#
# In development/test this variable may be left unset; each process will generate an
# ephemeral keypair automatically (suitable only for single-process local dev).
SEP10_SERVER_SECRET=

# API_KEY_LOOKUP_SECRET — Required in production. 32-byte hex pepper used to derive
# api_keys.lookup_hash, the indexed deterministic value that lets X-API-Key
# authentication find a candidate key row with one indexed query instead of scanning
# every active key (#1033). Generate with: openssl rand -hex 32
#
# WHY THIS MATTERS: every backend instance must share the same value, otherwise a key
# issued by instance A cannot be located by instance B and authentication fails behind
# a load balancer.
#
# THIS IS NOT THE AUTHENTICATION SECRET: possession of a raw API key is still proven
# against the salted api_keys.key_hash. This pepper only keeps the stored lookup column
# useless to anyone holding a read-only copy of the database.
#
# ROTATION: changing this value orphans every stored lookup_hash. See docs/auth.md for
# the supported procedure (null the column so keys re-derive on next use).
#
# In development/test this variable may be left unset; a fixed, insecure development-only
# pepper is used instead.
API_KEY_LOOKUP_SECRET=

# API_KEY_DEFAULT_TTL_DAYS — Optional. Default lifetime for issued API keys in days (#674).
# Keys issued without an explicit expiresInDays value expire after this many days. Default: 90.
# Set to 0 to disable automatic expiry (not recommended for production — prefer long but finite
# lifetimes instead so forgotten/leaked keys eventually decay).
API_KEY_DEFAULT_TTL_DAYS=90

# ADMIN_WALLET — Optional. Single admin Stellar address, for backward compatibility.
# Prefer ADMIN_WALLETS below.
# See docs/admin-multisig.md for multi-sig workflow and threshold configuration.
ADMIN_WALLET=

# ADMIN_WALLETS — Optional. Comma-separated admin Stellar addresses.
# Example: GABC123...,GDEF456...
# See docs/admin-multisig.md for multi-sig workflow and threshold configuration.
ADMIN_WALLETS=

# ADMIN_THRESHOLD — Optional. Admin signatures required for high-value operations. Default: 1. Integer >= 1.
ADMIN_THRESHOLD=1

# ----------------------------------------
# IPFS / Pinata
# ----------------------------------------
# PINATA_API_KEY — Required. Pinata IPFS upload credential.
PINATA_API_KEY=

# PINATA_SECRET — Required. Pinata IPFS upload credential — keep private, never commit.
PINATA_SECRET=

# PINATA_GATEWAY — Optional. IPFS gateway used to resolve pinned content. Must be a valid HTTPS URL.
# When unset, defaults to https://gateway.pinata.cloud.
# See docs/ipfs-pinata-gateway.md for configuration details, fallback behavior, and examples.
PINATA_GATEWAY=https://gateway.pinata.cloud

# IPFS_GATEWAYS — Optional. Comma-separated fallback IPFS gateways
# (defaults to Pinata/Cloudflare/ipfs.io when unset).
# See docs/ipfs-pinata-gateway.md for detailed fallback semantics and operator guidance.
IPFS_GATEWAYS=

# PIN_JSON_CACHE_TTL_MS — Optional. TTL for IPFS pin dedup cache, in ms. Default: 300000. Integer >= 0 (ms).
PIN_JSON_CACHE_TTL_MS=300000

# ----------------------------------------
# Runtime
# ----------------------------------------
# NODE_ENV — Required. "development", "production", or "test".
NODE_ENV=development

# PORT — Optional. API port. Default: 4000. Integer, 0–65535.
PORT=4000

# ----------------------------------------
# Platform
# ----------------------------------------
# PLATFORM_FEE_BPS — Optional. Platform fee in basis points (1 bps = 0.01%). Default: 500 (5%). Integer, 0–10000 (basis points; 10000 = 100%).
PLATFORM_FEE_BPS=500

# PLATFORM_SECRET_KEY — Required in staging/production. Platform signing keypair secret.
# Generate with: stellar keys generate --network testnet
PLATFORM_SECRET_KEY=

# PLATFORM_SECRET — Legacy/deprecated, used by src/utils/contract.ts. Prefer PLATFORM_SECRET_KEY.
PLATFORM_SECRET=

# ----------------------------------------
# Logging
# ----------------------------------------
# LOG_LEVEL — Optional. debug | info | warn | error. Default: info.
LOG_LEVEL=info

# LOG_SKIP_PATHS — Optional. Comma-separated paths requestLogger never logs
# (default: health + metrics probes).
LOG_SKIP_PATHS=/health,/health/liveness,/health/readiness,/ready,/metrics

# LOG_SAMPLE_RATE — Optional. Float 0–1 sample rate for non-skipped paths. Default: 1 (log all). Float 0–1.
LOG_SAMPLE_RATE=1

# ----------------------------------------
# Database
# ----------------------------------------
# DB_DRIVER — Optional. Database driver: "sqlite" (default) or "postgres".
# Set to "postgres" when running with horizontal scaling / multiple instances;
# SQLite is single-process only. Requires DATABASE_URL when set to "postgres".
# Any other value causes the server to fail at startup rather than silently
# defaulting to SQLite, so typos are caught immediately.
#
# See docs/postgres-migration.md for the full configuration table with
# accepted values, defaults, and per-provider guidance.
DB_DRIVER=sqlite

# DB_PATH — Optional. SQLite file path. Default: scout-off.db.
# Only used when DB_DRIVER=sqlite.
DB_PATH=scout-off.db

# DATABASE_URL — Required when DB_DRIVER=postgres.
# Format: postgresql://user:password@host:5432/dbname
# See docs/postgres-migration.md for examples and environment-specific guidance.
DATABASE_URL=

# DATABASE_SSL — Optional. Controls TLS for the PostgreSQL connection.
#   true       — Enable SSL with full certificate verification (recommended for
#                managed providers such as RDS, Heroku, Supabase, Neon, Railway).
#   no-verify  — Enable SSL but skip certificate verification.  Use only in
#                dev/staging environments with self-signed certificates.
#   false / unset — Disable SSL (local / private-network Postgres without TLS).
#
# See docs/postgres-migration.md for per-provider guidance (RDS, Heroku, Supabase, etc.).
DATABASE_SSL=

# DATABASE_POOL_SIZE — Optional. Maximum number of connections in the PostgreSQL
# connection pool. Only used when DB_DRIVER=postgres. Default: 10. Integer 1–100.
#
# See docs/postgres-migration.md for deployment-specific recommendations.
DATABASE_POOL_SIZE=10

# SLOW_QUERY_THRESHOLD_MS — Optional. Log queries slower than this, in ms. Default: 50.
SLOW_QUERY_THRESHOLD_MS=50

# ----------------------------------------
# Security headers (optional overrides)
# ----------------------------------------
SECURITY_HSTS=max-age=31536000; includeSubDomains
SECURITY_X_CONTENT_TYPE_OPTIONS=nosniff
SECURITY_X_FRAME_OPTIONS=DENY
SECURITY_REFERRER_POLICY=no-referrer
SECURITY_CSP=default-src 'none'
SECURITY_PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=()

# ----------------------------------------
# Feature flags
# ----------------------------------------
# STELLAR_HEALTH_CHECK — Optional. Set false in staging to skip the Stellar RPC health
# check on startup. Default: true.
STELLAR_HEALTH_CHECK=true

# JSON_PAYLOAD_LIMIT — Optional. Max size of JSON request bodies. Default: 1mb.
JSON_PAYLOAD_LIMIT=1mb

# UPLOAD_PAYLOAD_LIMIT — Optional. Max size of JSON request bodies for upload
# endpoints (player registration, milestone evidence). Default: 10mb.
UPLOAD_PAYLOAD_LIMIT=10mb

# EVIDENCE_MAX_BYTES — Optional. Max size in bytes of a downloaded HTTPS
# evidence file for milestone submissions. Default: 52428800 (50 MB). Integer >= 1 (bytes).
EVIDENCE_MAX_BYTES=52428800

# COMPRESSION_THRESHOLD — Optional. Response compression threshold, in bytes. Default: 1024. Integer >= 1 (bytes).
COMPRESSION_THRESHOLD=1024

# COMPRESSION_THRESHOLD_BYTES — Optional. Accepted alias for COMPRESSION_THRESHOLD
# above; only used as a fallback when COMPRESSION_THRESHOLD is unset. Leave unset.
COMPRESSION_THRESHOLD_BYTES=

# ----------------------------------------
# Caching
# ----------------------------------------
# PLAYER_CACHE_TTL_MS — Optional. Cache TTL for player lookups, in ms. Default: 60000. Integer >= 0 (ms).
PLAYER_CACHE_TTL_MS=60000

# SEARCH_CACHE_MAX_SIZE — Optional. Maximum number of entries retained in the in-memory
# search cache before the least-recently-used entry is evicted. Default: 10000. Integer >= 1.
SEARCH_CACHE_MAX_SIZE=10000

# CACHE_NAMESPACE — Optional. Prefix applied to every cache key written to Redis (#672).
# Prevents key collisions when two deployments (staging + production, or a blue/green pair)
# share the same Redis instance. Defaults to NODE_ENV out-of-the-box, providing basic
# isolation without any explicit configuration.
# Override this to a stable deployment identifier (e.g. "production", "staging", "blue")
# so that a NODE_ENV=production deployment can be distinguished from another one on the
# same cluster.
# Example: CACHE_NAMESPACE=production-blue
CACHE_NAMESPACE=

# PLAYER_IMPORT_MAX_BATCH — Optional. Max rows accepted per bulk player
# import request (POST /api/admin/players/import). Default: 500. Integer >= 1.
PLAYER_IMPORT_MAX_BATCH=500

# PLAYER_IMPORT_RATE_LIMIT_WINDOW_MS / PLAYER_IMPORT_RATE_LIMIT_MAX — Optional.
# Rate limit for POST /api/admin/players/import. Defaults: 60000 / 5 (relaxed
# to 1000 automatically when NODE_ENV=test). Integer >= 1.
PLAYER_IMPORT_RATE_LIMIT_WINDOW_MS=60000
PLAYER_IMPORT_RATE_LIMIT_MAX=5

# ----------------------------------------
# CORS
# ----------------------------------------
# CORS_ALLOWED_ORIGINS — Comma-separated list of allowed origins.
# Recommended values per environment:
#   development: * (or http://localhost:3000,http://localhost:4000)
#   staging:     https://staging.scoutoff.io
#   production:  https://app.scoutoff.io,https://scoutoff.io
# Falls back to environment-specific defaults if unset:
#   development/test: *
#   staging:          https://staging.scoutoff.io
#   production:       https://app.scoutoff.io,https://scoutoff.io
CORS_ALLOWED_ORIGINS=

# ALLOWED_ORIGINS — Legacy alias for CORS_ALLOWED_ORIGINS.
ALLOWED_ORIGINS=

# ----------------------------------------
# Rate limiting
# ----------------------------------------
# RATE_LIMIT_ENABLED — Optional. Default: true.
# See docs/rate-limiting.md for complete configuration, namespacing, and fail-open policy.
RATE_LIMIT_ENABLED=true

# RATE_LIMIT_WINDOW_MS / RATE_LIMIT_MAX — Optional. Defaults: 60000 / 60. Integer >= 1.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# AUTH_RATE_LIMIT_WINDOW_MS / AUTH_RATE_LIMIT_MAX — Optional. Stricter limits on
# /auth/challenge and /auth/token for brute-force protection. Defaults: 60000 / 5. Integer >= 1.
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=5

# WEBHOOK_TEST_RATE_LIMIT_WINDOW_MS / WEBHOOK_TEST_RATE_LIMIT_MAX — Optional.
# Rate limit for POST /api/scouts/:wallet/webhooks/:id/test, isolated from the
# shared default walletRateLimit() pool since each call makes the backend
# issue an outbound HTTP request to a caller-supplied URL. Defaults: 60000 / 5
# (relaxed to 1000 automatically when NODE_ENV=test). Integer >= 1.
WEBHOOK_TEST_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_TEST_RATE_LIMIT_MAX=5

# IP_REPUTATION_ENABLED — Optional. Tracks per-IP auth failures / 4xx errors and
# temporarily blocks abusive IPs. Defaults to true, except in NODE_ENV=test
# (disabled there so shared-IP negative-path test assertions don't trip it).
IP_REPUTATION_ENABLED=true

# ----------------------------------------
# Webhooks
# ----------------------------------------
# WEBHOOK_ENABLED — Optional. Default: false.
WEBHOOK_ENABLED=false

# WEBHOOK_URL — Required if WEBHOOK_ENABLED=true. Destination for webhook events.
# Example: https://example.com/webhooks/scout-off
WEBHOOK_URL=

# WEBHOOK_SECRET — Optional. HMAC secret used to sign the X-Webhook-Signature
# header for the legacy single-subscriber webhook (WEBHOOK_URL). A random secret
# is generated on startup if unset.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# WEBHOOK_SECRET_ENCRYPTION_KEY — Required in production if any webhook
# subscriptions exist. 32-byte hex key used to encrypt webhook_subscriptions.secret
# at rest (#686); the plaintext secret is only ever decrypted in memory, at the
# point of signing an outbound delivery. Generate with: openssl rand -hex 32
# See docs/secrets-rotation.md for rotation guidance.
WEBHOOK_SECRET_ENCRYPTION_KEY=

# WEBHOOK_TIMEOUT_MS — Optional. Default: 10000 (10s). Per-attempt timeout for
# outbound webhook delivery requests (#691). An unresponsive subscriber is
# aborted after this window and the attempt is treated as a failure, so it
# proceeds to retry/backoff or dead-lettering instead of hanging indefinitely.
WEBHOOK_TIMEOUT_MS=10000

# WEBHOOK_DLQ_SIZE_THRESHOLD — Optional. Default: 100. Absolute dead-letter
# queue depth that triggers a critical log (+ optional admin notify) (#1131).
WEBHOOK_DLQ_SIZE_THRESHOLD=100

# WEBHOOK_DLQ_RATE_THRESHOLD — Optional. Default: 50. Number of dead-letter
# inserts within WEBHOOK_DLQ_RATE_WINDOW_MS that triggers the same alert.
WEBHOOK_DLQ_RATE_THRESHOLD=50

# WEBHOOK_DLQ_RATE_WINDOW_MS — Optional. Default: 300000 (5 min). Sliding
# window used for the insert-rate check above.
WEBHOOK_DLQ_RATE_WINDOW_MS=300000

# PLATFORM_ADMIN_NOTIFY_URL — Optional. When set, a JSON POST is sent here
# whenever the dead-letter size or rate threshold is crossed.
PLATFORM_ADMIN_NOTIFY_URL=

# ----------------------------------------
# API versioning
# ----------------------------------------
# API_PREFIX — Optional. Default: /api.
API_PREFIX=/api

# API_V — Optional. Default: v1.
API_V=v1

# API_V1_PREFIX — Optional. Full versioned prefix. Default: /api/v1.
# Routes are registered under both API_PREFIX and API_V1_PREFIX.
API_V1_PREFIX=/api/v1

# API_V2_PREFIX — Optional. Full v2 prefix. Default: /api/v2.
API_V2_PREFIX=/api/v2

# ----------------------------------------
# Metrics
# ----------------------------------------
# METRICS_ENABLED — Optional. Expose a /metrics endpoint. Default: false.
METRICS_ENABLED=false

# ----------------------------------------
# Server-Sent Events (SSE)
# ----------------------------------------
# SSE_KEEPALIVE_INTERVAL_MS — Optional. Interval between SSE keep-alive ping
# comments sent to connected clients, in ms. Prevents idle-connection timeouts
# in proxies and load balancers. Default: 15000 (15 s).
SSE_KEEPALIVE_INTERVAL_MS=15000

# SSE_MAX_CONNECTIONS — Optional. Maximum number of concurrent SSE connections.
# Set to 0 (default) for unlimited. Clients exceeding the limit receive 503.
SSE_MAX_CONNECTIONS=0

# SSE_AUTH_SWEEP_INTERVAL_MS — Optional. Interval for the shared SSE authorization
# sweep that re-checks the token-revocation and wallet blocklists (one query per
# process, never per keep-alive tick). Bounds cross-process revocation detection.
# Default: 30000 (30 s).
SSE_AUTH_SWEEP_INTERVAL_MS=30000

# WALLET_BLOCKLIST_CACHE_TTL_MS — Optional. How long a cached wallet-blocklist
# entry is trusted before a fresh DB read. Default: 30000 (30 s).
WALLET_BLOCKLIST_CACHE_TTL_MS=30000

# ----------------------------------------
# Milestone rate limiting
# ----------------------------------------
# MILESTONE_RATE_WINDOW_MS / MILESTONE_RATE_MAX — Optional. Defaults: 60000 / 10.
MILESTONE_RATE_WINDOW_MS=60000
MILESTONE_RATE_MAX=10

# ----------------------------------------
# Redis (optional — distributed caching)
# ----------------------------------------
# REDIS_URL — Optional. Falls back to in-memory caching when unset.
# Format: redis://<user>:<password>@<host>:<port>
REDIS_URL=

# ----------------------------------------
# Proxy
# ----------------------------------------
# TRUSTED_PROXY_COUNT — Optional. Number of trusted reverse-proxy hops in front of
# this server, used to resolve real client IPs. Default: 1.
TRUSTED_PROXY_COUNT=1

# ----------------------------------------
# Indexer
# ----------------------------------------
# INDEXER_BACKFILL_FROM_LEDGER — Optional. Replay indexing from this ledger if earlier
# than the stored last_ledger. Leave unset to disable.
# See docs/reindexing.md for operational workflows and cursor management.
INDEXER_BACKFILL_FROM_LEDGER=

# INDEXER_LAG_WARN_THRESHOLD — Optional. Ledgers behind tip before a lag warning logs.
# Default: 100.
# See docs/reindexing.md for monitoring and alerting guidance.
INDEXER_LAG_WARN_THRESHOLD=100

# INDEXER_FINALITY_MARGIN — Optional. Ledgers to hold back from the RPC's reported
# tip before indexing, to avoid ingesting events from a ledger that later gets
# reorged. Default: 10.
INDEXER_FINALITY_MARGIN=10

# ----------------------------------------
# Subscriptions
# ----------------------------------------
# SUBSCRIPTION_GRACE_PERIOD_HOURS — Optional. Grace period after expiry during which
# access is still granted. Default: 24. Integer >= 0.
SUBSCRIPTION_GRACE_PERIOD_HOURS=24

# ----------------------------------------
# Requests
# ----------------------------------------
# REQUEST_TIMEOUT_MS — Optional. Global request timeout before responding 503.
# Default: 30000. Integer >= 1 (ms).
REQUEST_TIMEOUT_MS=30000
# TX_CONFIRMATION_TIMEOUT_MS — Optional. Bounded Soroban transaction-confirmation
# poll window for pay_to_contact / subscribe submissions. Default: 60000. Integer >= 1000 (ms).
TX_CONFIRMATION_TIMEOUT_MS=60000
# IPFS_HTTP_TIMEOUT_MS — Optional. Per-request HTTP timeout for Pinata/IPFS axios
# calls. Default: 15000. Integer >= 1 (ms).
IPFS_HTTP_TIMEOUT_MS=15000
# STELLAR_RPC_TIMEOUT_MS — Optional. Per-request HTTP timeout for Soroban RPC /
# Stellar SDK calls. Default: 15000. Integer >= 1 (ms).
STELLAR_RPC_TIMEOUT_MS=15000

# ----------------------------------------
# Admin
# ----------------------------------------
# ADMIN_IP_ALLOWLIST — Optional. Comma-separated IPs/CIDRs allowed on admin routes.
# Leave unset to allow all.
ADMIN_IP_ALLOWLIST=

# ADMIN_ACTION_TTL_MS — Optional. Time-to-live for pending admin multi-sig actions, in ms.
# Default: 3600000 (1 hour). Integer >= 1 (ms).
ADMIN_ACTION_TTL_MS=3600000

# ----------------------------------------
# Tracing (OpenTelemetry)
# ----------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT — Optional. Leave unset to disable tracing export.
OTEL_EXPORTER_OTLP_ENDPOINT=

# OTEL_SERVICE_NAME — Optional. Service name reported to the tracing backend.
OTEL_SERVICE_NAME=scout-off-backend

# ----------------------------------------
# System / Build
# ----------------------------------------
# GIT_COMMIT — Optional. Git commit SHA reported by the GET /version endpoint.
# Set automatically by the Docker build via ARG GIT_COMMIT (see Dockerfile).
# Override manually only when running outside Docker and the BUILD_COMMIT file
# is not present. Leave empty to fall back to the BUILD_COMMIT file or "unknown".
GIT_COMMIT=
